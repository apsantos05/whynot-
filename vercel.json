{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ingressos",
      "destination": "https://whynotcrm.vercel.app/ingressos"
    },
    {
      "source": "/ingressos/:path*",
      "destination": "https://whynotcrm.vercel.app/ingressos/:path*"
    },
    {
      "source": "/pedido/:path*",
      "destination": "https://whynotcrm.vercel.app/pedido/:path*"
    },
    {
      "source": "/meus-ingressos",
      "destination": "https://whynotcrm.vercel.app/meus-ingressos"
    },
    {
      "source": "/minha-conta",
      "destination": "https://whynotcrm.vercel.app/minha-conta"
    },
    {
      "source": "/minha-conta/:path*",
      "destination": "https://whynotcrm.vercel.app/minha-conta/:path*"
    },
    {
      "source": "/api/checkout",
      "destination": "https://whynotcrm.vercel.app/api/checkout"
    },
    {
      "source": "/api/pedido/:path*",
      "destination": "https://whynotcrm.vercel.app/api/pedido/:path*"
    },
    {
      "source": "/api/meus-ingressos",
      "destination": "https://whynotcrm.vercel.app/api/meus-ingressos"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://whynotcrm.vercel.app/_next/:path*"
    }
  ]
}